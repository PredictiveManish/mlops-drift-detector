# Copy to .env and fill in. Nothing here has a working default on purpose.

# Discord webhook for drift alerts. Create it in Discord:
#   Channel settings -> Integrations -> Webhooks -> New Webhook
# Leave empty to disable alerts. Never commit the real URL.
DISCORD_WEBHOOK=

# Alert threshold on the 0-1 normalised PSI score.
ALERT_THRESHOLD=0.15

# SQLite file holding predictions and the frozen baseline.
DB_PATH=predictions.db

# Drift window and the minimum samples needed on each side before scoring.
WINDOW_SIZE=100
MIN_BASELINE_SAMPLES=30
MIN_RECENT_SAMPLES=30
